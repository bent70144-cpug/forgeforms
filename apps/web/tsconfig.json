{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      // INTEGRATION-DEBT (T10): source aliases until workspace deps for
      // @formforge/* + transpilePackages land in apps/web/package.json
      // (deps rule: T10 may only touch packages/{core,db} manifests).
      "@formforge/core": ["../../packages/core/src/index.ts"],
      "@formforge/db": ["../../packages/db/src/index.ts"],
      "@/*": ["./*"]
    },
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "jsx": "preserve",
    "module": "esnext",
    "incremental": true,
    "types": [
      "node"
    ],
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
