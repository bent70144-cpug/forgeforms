    "seed": "node src/seed.ts"
  },
  "dependencies": {
    "@formforge/core": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "@types/pg": "^8.15.0"
  }
}
