  {
    "name": "start rules can seed variables from hidden fields",
    "rules": [
      {
        "id": "seed",
        "scope": "start",
        "when": [
          {
            "left": "@hidden:campaign",
            "op": "eq",
            "right": "spring"
          }
        ],
        "then": [
          {
            "type": "set",
            "var": "greeting",
            "value": "spring-campaign"
          }
        ]
      }
    ],
    "blocks": [
      {
        "id": "b1",
        "kind": "short-text",
        "props": {}
      },
      {
        "id": "b2",
        "kind": "single-select",
        "props": {}
      },
      {
        "id": "b3",
        "kind": "rating",
        "props": {}
      }
    ],
    "endings": [
      "done"
    ],
    "steps": [
      {
        "ctx": {
          "answers": {},
          "variables": {},
          "hidden": {
            "campaign": "spring"
          },
          "currentBlockId": "start"
        },
        "expect": {
          "nextBlockId": "b1",
          "variables": {
            "greeting": "spring-campaign"
          }
        }
      },
      {
        "ctx": {
          "answers": {},
          "variables": {},
          "hidden": {},
          "currentBlockId": "start"
        },
        "expect": {
          "nextBlockId": "b1",
          "variables": {}
        }
      }
    ]
