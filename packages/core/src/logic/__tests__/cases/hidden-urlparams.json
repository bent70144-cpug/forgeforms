[
  {
    "name": "@hidden resolves from ctx.hidden",
    "rules": [
      {
        "id": "r1",
        "scope": "b1",
        "when": [
          {
            "left": "@hidden:campaign",
            "op": "eq",
            "right": "spring"
          }
        ],
        "then": [
          {
            "type": "goto",
            "target": "end:done"
          }
        ]
      }
    ],
    "blocks": [
      {
        "id": "b1",
        "kind": "short-text",
        "props": {}
      },
      {
        "id": "b2",
        "kind": "single-select",
        "props": {}
      },
      {
        "id": "b3",
        "kind": "rating",
        "props": {}
      }
    ],
    "endings": [
      "done"
    ],
    "steps": [
      {
        "ctx": {
          "answers": {},
          "variables": {},
          "hidden": {
            "campaign": "spring"
          },
          "currentBlockId": "b1"
        },
        "expect": {
          "nextBlockId": "end:done",
          "variables": {}
        }
      }
    ]
  },
