[
  {
    "name": "eq: string answer matches literal → goto fires",
    "rules": [
      { "id": "r1", "scope": "b1", "when": [{ "left": "@block:b1", "op": "eq", "right": "hello" }], "then": [{ "type": "goto", "target": "end:done" }] }
    ],
    "blocks": [
      { "id": "b1", "kind": "short-text", "props": {} },
      { "id": "b2", "kind": "single-select", "props": {} },
      { "id": "b3", "kind": "rating", "props": {} }
    ],
    "endings": ["done"],
    "steps": [
      {
        "ctx": { "answers": { "b1": "hello" }, "variables": {}, "hidden": {}, "currentBlockId": "b1" },
        "expect": { "nextBlockId": "end:done", "variables": {} }
      }
    ]
  },
  {
    "name": "eq: string mismatch → default next",
    "rules": [
      { "id": "r1", "scope": "b1", "when": [{ "left": "@block:b1", "op": "eq", "right": "hello" }], "then": [{ "type": "goto", "target": "end:done" }] }
    ],
    "blocks": [
      { "id": "b1", "kind": "short-text", "props": {} },
      { "id": "b2", "kind": "single-select", "props": {} },
      { "id": "b3", "kind": "rating", "props": {} }
    ],
    "endings": ["done"],
    "steps": [
      {
        "ctx": { "answers": { "b1": "world" }, "variables": {}, "hidden": {}, "currentBlockId": "b1" },
        "expect": { "nextBlockId": "b2", "variables": {} }
      }
    ]
  },
  {
    "name": "eq: rating answer is already a number",
    "rules": [
      { "id": "r1", "scope": "b3", "when": [{ "left": "@block:b3", "op": "eq", "right": 5 }], "then": [{ "type": "goto", "target": "b1" }] }
