[
  {
    "name": "goto: forward jump skips blocks",
    "rules": [
      {
        "id": "r1",
        "scope": "b1",
        "when": [
          {
            "left": "@block:b1",
            "op": "eq",
            "right": "skip"
          }
        ],
        "then": [
          {
            "type": "goto",
            "target": "b3"
          }
        ]
      }
    ],
    "blocks": [
      {
        "id": "b1",
        "kind": "short-text",
        "props": {}
      },
      {
        "id": "b2",
        "kind": "single-select",
        "props": {}
      },
      {
        "id": "b3",
        "kind": "rating",
        "props": {}
      }
    ],
    "endings": [
      "done"
    ],
    "steps": [
      {
        "ctx": {
          "answers": {
            "b1": "skip"
          },
          "variables": {},
          "hidden": {},
          "currentBlockId": "b1"
        },
        "expect": {
          "nextBlockId": "b3",
          "variables": {}
        }
      }
    ]
  },
