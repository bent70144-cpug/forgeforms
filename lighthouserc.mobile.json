{
  "$schema": "https://github.com/GoogleChrome/lighthouse-ci/blob/main/docs/schema.md",
  "comment": "T28 (issue #28) — mobile Lighthouse budgets (spec §15 M3: Performance ≥85 mobile, Accessibility ≥90). Generated runtime copy gets the published /p/:slug URL appended by scripts/lhci-seed.mjs.",
  "ci": {
    "collect": {
      "url": ["http://localhost:3000/dev/form-plane-harness"],
      "numberOfRuns": 1,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": { "mobile": true, "width": 390, "height": 844, "deviceScaleFactor": 2.625, "disabled": false },
        "throttling": { "rttMs": 150, "throughputKbps": 1638.4, "requestLatencyMs": 562.5, "downloadThroughputKbps": 1638.4, "uploadThroughputKbps": 675, "cpuSlowdownMultiplier": 4 },
        "skipAudits": ["canonical", "is-crawlable", "maskable-icon", "installable-manifest", "service-worker", "offline-start-url", "splash-screen", "themed-omnibox", "content-width"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": "off"
      }
    }
  }
}
