# FormForge — local development environment template.
# Copy to .env and fill in secrets: cp .env.example .env
# Boot-time validation lives in packages/core/src/shared/env.ts (fail fast).
# Required at boot: DATABASE_URL, SESSION_SECRET, AUTH_SECRET.
# Integration keys are optional — the features that need them check for
# their own key at call time.

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
# ≥ 32 chars — generate with: openssl rand -hex 32
SESSION_SECRET=
AUTH_SECRET=
LOG_LEVEL=info

# --- Database / cache (docker compose provides both) ------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/formforge
REDIS_URL=redis://localhost:6379

# --- Auth (OAuth, optional) --------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Object storage (S3-compatible; local MinIO defaults shown) -------------
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=formforge
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_PUBLIC_CDN_URL=

# --- Email (optional; console mailer used when RESEND_API_KEY is unset) -----
# RESEND_API_KEY=
EMAIL_FROM=FormForge <notifications@formforge.dev>

# --- Billing (Stripe, optional) ----------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_BUSINESS=

# --- Abuse protection (Cloudflare Turnstile, optional) -----------------------
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- AI (Phase M8) ------------------------------------------------------------
AI_MODEL=claude-sonnet-4-6

# --- Edge / custom domains (optional; manual DNS fallback when unset) --------
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# FORMFORGE_ROUTING_TARGET=

# --- Worker -------------------------------------------------------------------
MAIL_FROM=FormForge <notifications@formforge.dev>
WORKER_CONCURRENCY=5
